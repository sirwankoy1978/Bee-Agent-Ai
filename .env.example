# Copy to `.env` (never commit `.env`). Every value has a working default in
# bee/config.py - this file only lists what you can override.

# --- Credentials --------------------------------------------------------------
OPENAI_API_KEY=***
TELEGRAM_TOKEN=***
# 1-256 letters/digits/underscores/hyphens (Telegram setWebhook rules)
TELEGRAM_WEBHOOK_SECRET_TOKEN=BeeAg…-hex
# "development" DISABLES the webhook secret check. Keep unset for tunnels/prod.
# APP_ENV=development

# --- Model (public OpenAI API) --------------------------------------------------
OPENAI_MODEL=gpt-5.4-mini
# chat = Chat Completions endpoint, responses = Responses endpoint
OPENAI_API_KIND=chat
# minimal | low | medium | high (GPT-5 family)
# OPENAI_REASONING_EFFORT=low
OPENAI_IMAGE_MODEL=gpt-image-2

# --- Server -------------------------------------------------------------------
HOST=0.0.0.0
PORT=7777
RELOAD=0

# --- Telegram interface behavior -----------------------------------------------
BOT_MODE=agent            # agent | team | workflow
TG_PREFIX=/telegram
TELEGRAM_STREAMING=1
TELEGRAM_SHOW_REASONING=0
TG_REPLY_TO_MENTIONS_ONLY=1
TG_REPLY_TO_BOT_MESSAGES=1
TG_QUOTED_RESPONSES=0
TG_REGISTER_COMMANDS=1

# --- Agent capabilities ----------------------------------------------------------
ENABLE_WEB_SEARCH=1
ENABLE_REASONING_TOOLS=1
ENABLE_IMAGE_GENERATION=1
ENABLE_TTS=0
ENABLE_USER_MEMORY=1
NUM_HISTORY_RUNS=3

# Outbound TelegramTools (default chat for proactive sends). Find yours with:
#   python telegram_bot.py delete-webhook && python telegram_bot.py find-chat-id
# TELEGRAM_CHAT_ID=-1001234567890
ENABLE_TELEGRAM_TOOLS=0

# --- Storage / AgentOS extras -------------------------------------------------------
DB_FILE=tmp/bee_telegram.db
SESSION_TABLE=telegram_sessions
AGENTOS_TRACING=0
AGENTOS_MCP=0
